## LLM opponent support is optional; the rules agents and browser demo do not require any of these.
## Copy this file to .env and fill in only what you need for `pnpm web:serve` or the LLM CLI entry points.

# OpenAI-compatible provider
# OPENAI_API_KEY=
# LLM_MODEL=

# Alternative OpenAI-compatible base URL (e.g. a gateway)
# LLM_BASE_URL=
# LLM_API=chat

# Gemini provider
# GEMINI_API_KEY=
# LLM_API=gemini
# LLM_MODEL=
