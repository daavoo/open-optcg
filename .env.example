## Only the LLM evaluation tools read these (docs/llm-evaluation.md); playing needs none of them.
## Copy this file to .env and fill in only what you need.

# OpenAI-compatible provider
# OPENAI_API_KEY=
# LLM_MODEL=

# Alternative OpenAI-compatible base URL (e.g. a gateway)
# LLM_BASE_URL=
# LLM_API=chat

# Gemini provider
# GEMINI_API_KEY=
# LLM_API=gemini
# LLM_MODEL=
