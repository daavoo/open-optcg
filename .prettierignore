# Generated by `pnpm analytics:baseline`. Kept minified because build-web.ts
# inlines it verbatim into dist/open-optcg.html, where pretty-printing it would
# cost a few hundred kilobytes for no reader.
packages/web/src/analytics-baseline.json

# Machine-written records, not source. Benchmark reports come out of
# `pnpm deck:benchmark`/`analytics:baseline` and traces out of `--trace`; both
# are compared and regenerated verbatim, so reformatting them only produces
# diff noise and a format gate that fails on evidence nobody edits by hand.
analysis/*.json
*-trace.json
*.trace.json
pnpm-lock.yaml
dist-tsc/
ml/python/.mypy_cache/
ml/python/.ruff_cache/
ml/python/__pycache__/

# Agent worktrees: whole extra checkouts of this repo, under `.claude/worktrees/`
# where the tooling writes them and under `worktrees/` where one made by hand
# usually lands. They are excluded from git per-machine (`.git/info/exclude`),
# which this file does not inherit, so without these lines `prettier --check .`
# formats every branch you have in flight -- and eslint, walking the same trees,
# ran out of memory. Ignored in `eslint.config.js` for the same reason.
.claude/worktrees/
worktrees/

